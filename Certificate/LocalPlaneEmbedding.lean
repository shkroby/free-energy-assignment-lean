import Mathlib.Order.Hom.Set
import Mathlib.Data.List.Induction
import Mathlib.Tactic

/-!
# Disjoint labelled placements of a fixed plane shape

Once the child order is fixed, all labels in a rooted tree neighborhood are
determined by the successive lists of neighbors.
-/

open Set

namespace Certificate.LocalExploration

/-- A depth-truncated plane shape is a collection of words with consecutive
child indices. The degree constraint is imposed only inside the depth. -/
structure PlaneShape where
  slots : Set (List ℕ)
  depth : ℕ
  childCount : List ℕ → ℕ
  root_mem : [] ∈ slots
  child_mem : ∀ v i, v ++ [i] ∈ slots ↔ v ∈ slots ∧ v.length < depth ∧ i < childCount v

namespace PlaneShape

/-- The part of a plane shape on any fixed level is finite. -/
theorem finite_level (shape : PlaneShape) (k : ℕ) :
    {v ∈ shape.slots | List.length v = k}.Finite := by
  induction k with
  | zero =>
    apply (finite_singleton ([] : List ℕ)).subset
    intro v hv
    exact List.length_eq_zero_iff.mp hv.2
  | succ k ih =>
    let previous := {v ∈ shape.slots | List.length v = k}
    let children (v : List ℕ) := (fun i : Fin (shape.childCount v) ↦ v ++ [i.val]) '' univ
    have hChild (v : List ℕ) : (children v).Finite := finite_univ.image _
    refine (ih.biUnion fun v _ ↦ hChild v).subset ?_
    intro v hv
    induction v using List.reverseRecOn with
    | nil => simp at hv
    | append_singleton u i _ =>
      obtain ⟨hu, _, hi⟩ := (shape.child_mem u i).mp hv.1
      have hulen : u.length = k := by simpa using hv.2
      exact mem_iUnion₂.mpr ⟨u, ⟨hu, hulen⟩, ⟨⟨i, hi⟩, mem_univ _, rfl⟩⟩

/-- There are finitely many slots in a depth-truncated plane shape. -/
theorem finite_slots (shape : PlaneShape) : shape.slots.Finite := by
  have hl (v : List ℕ) (hv : v ∈ shape.slots) : v.length ≤ shape.depth := by
    induction v using List.reverseRecOn with
    | nil => simp
    | append_singleton u i _ =>
      have := ((shape.child_mem u i).mp hv).2.1
      simpa using Nat.succ_le_of_lt this
  refine ((finite_le_nat shape.depth).biUnion fun k _ ↦ shape.finite_level k).subset ?_
  intro v hv
  exact mem_iUnion₂.mpr ⟨v.length, hl v hv, hv, rfl⟩

/-- Words that appear when the designated offspring counts are explored to
the given depth. -/
def generatedSlots (depth : ℕ) (counts : List ℕ → ℕ) : Set (List ℕ) :=
  fun v ↦ v.reverseRecOn True fun u i follows ↦ follows ∧ u.length < depth ∧ i < counts u

/-- The unique shape generated by the counts up to the fixed depth. -/
def ofOffspring (depth : ℕ) (counts : List ℕ → ℕ) : PlaneShape where
  slots := generatedSlots depth counts
  depth := depth
  childCount := counts
  root_mem := by
    change ([] : List ℕ).reverseRecOn True (fun u i follows ↦ follows ∧ u.length < depth ∧ i < counts u)
    rw [List.reverseRecOn_nil]
    exact True.intro
  child_mem := by
    intro v i
    change (v ++ [i]).reverseRecOn True (fun u j follows ↦ follows ∧ u.length < depth ∧ j < counts u) ↔
      (v.reverseRecOn True (fun u j follows ↦ follows ∧ u.length < depth ∧ j < counts u)) ∧
        v.length < depth ∧ i < counts v
    rw [List.reverseRecOn_concat]

/-- A prescribed shape is realized exactly when its interior counts agree. -/
theorem ofOffspring_slots_eq_iff (shape : PlaneShape) (counts : List ℕ → ℕ) :
    (ofOffspring shape.depth counts).slots = shape.slots ↔
      ∀ v ∈ shape.slots, v.length < shape.depth → counts v = shape.childCount v := by
  constructor
  · intro h v hv hd
    have ht (i : ℕ) : i < counts v ↔ i < shape.childCount v := by
      have eqMem : v ++ [i] ∈ (ofOffspring shape.depth counts).slots ↔ v ++ [i] ∈ shape.slots := by rw [h]
      rw [(ofOffspring shape.depth counts).child_mem, shape.child_mem] at eqMem
      change (v ∈ (ofOffspring shape.depth counts).slots ∧ v.length < shape.depth ∧ i < counts v) ↔
        v ∈ shape.slots ∧ v.length < shape.depth ∧ i < shape.childCount v at eqMem
      rw [h] at eqMem
      simpa only [hv, hd, true_and] using eqMem
    by_contra! hn
    rcases lt_or_gt_of_ne hn with hlt | hgt
    · exact (Nat.lt_irrefl _ ((ht (counts v)).mpr hlt))
    · exact (Nat.lt_irrefl _ ((ht (shape.childCount v)).mp hgt))
  · intro h
    ext v
    induction v using List.reverseRecOn with
    | nil => exact ⟨fun _ ↦ shape.root_mem, fun _ ↦ (ofOffspring _ _).root_mem⟩
    | append_singleton u i ih =>
      rw [(ofOffspring shape.depth counts).child_mem, shape.child_mem, ih]
      constructor
      · rintro ⟨hu, hd, hi⟩
        exact ⟨hu, hd, (h u hu hd) ▸ hi⟩
      · rintro ⟨hu, hd, hi⟩
        refine ⟨hu, hd, ?_⟩
        change i < counts u
        rwa [h u hu hd]

end PlaneShape

private def parentLabelSet {V : Type*} (label : List ℕ → V) (v : List ℕ) : Set V :=
  if v = [] then ∅ else {label v.dropLast}

/-- The retained neighbors of each interior label are its parent's label
and its children, with children in the given increasing label order. -/
def MatchesPlaneShape {V : Type*} [LinearOrder V] (shape : PlaneShape)
    (root : V) (neighbors : V → Set V) (label : List ℕ → V) : Prop :=
  label [] = root ∧ ∀ v ∈ shape.slots, v.length < shape.depth →
    let child (i : Fin (shape.childCount v)) := label (v ++ [i.val])
    StrictMono child ∧ neighbors (label v) \ parentLabelSet label v = range child

/-- Two ordered placements describing the same rooted neighborhood agree
on all slots of the shape. -/
theorem matchesPlaneShape_eqOn {V : Type*} [LinearOrder V] {shape : PlaneShape}
    {root : V} {neighbors : V → Set V} {f g : List ℕ → V}
    (hf : MatchesPlaneShape shape root neighbors f) (hg : MatchesPlaneShape shape root neighbors g) :
    EqOn f g shape.slots := by
  have h (n : ℕ) : ∀ v ∈ shape.slots, v.length = n → f v = g v := by
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro v hv hlen
      induction v using List.reverseRecOn with
      | nil => exact hf.1.trans hg.1.symm
      | append_singleton u i _ =>
        obtain ⟨hu, huDepth, hi⟩ := (shape.child_mem u i).mp hv
        have hun : u.length < n := by simp [← hlen]
        have hparent : f u = g u := ih _ hun u hu rfl
        have hparSets : parentLabelSet f u = parentLabelSet g u := by
          unfold parentLabelSet
          split
          · rfl
          next hne =>
            have hd : u.dropLast ∈ shape.slots := by
              have hh : u.dropLast ++ [u.getLast hne] ∈ shape.slots := by
                rwa [List.dropLast_append_getLast hne]
              exact ((shape.child_mem _ _).mp hh).1
            have hshort : u.dropLast.length < n := by
              have hh := congrArg List.length (List.dropLast_append_getLast hne)
              simp only [List.length_append, List.length_cons, List.length_nil, zero_add] at hh
              omega
            rw [ih _ hshort _ hd rfl]
        have hF := hf.2 u hu huDepth
        have hG := hg.2 u hu huDepth
        have hRanges :
            range (fun j : Fin (shape.childCount u) ↦ f (u ++ [j.val])) =
              range (fun j : Fin (shape.childCount u) ↦ g (u ++ [j.val])) := by
          rw [← hF.2, ← hG.2, hparent, hparSets]
        have hEq := (hF.1.range_inj hG.1).mp hRanges
        exact congrFun hEq ⟨i, hi⟩
  exact fun v hv ↦ h v.length v hv rfl

/-- Different ordered placements impose disjoint exact neighborhood
events, independently of the random graph law. -/
theorem disjoint_planePlacementEvents {Ω V : Type*} [LinearOrder V]
    (shape : PlaneShape) (root : V) (neighbors : Ω → V → Set V)
    {f g : List ℕ → V} (hne : ¬ EqOn f g shape.slots) :
    Disjoint {ω | MatchesPlaneShape shape root (neighbors ω) f}
      {ω | MatchesPlaneShape shape root (neighbors ω) g} := by
  apply Set.disjoint_left.mpr
  intro ω hf hg
  exact hne (matchesPlaneShape_eqOn hf hg)

private theorem eq_of_ordered_range {V : Type*} [LinearOrder V] {k m : ℕ}
    {f : Fin k → V} {g : Fin m → V} (hf : StrictMono f) (hg : StrictMono g)
    (hRange : range f = range g) :
    ∃ h : k = m, ∀ i : Fin k, f i = g (Fin.cast h i) := by
  let ef := Equiv.ofInjective f hf.injective
  let eg := Equiv.ofInjective g hg.injective
  have hm : k = m := by
    have h := Fintype.card_congr (ef.trans ((Equiv.setCongr hRange).trans eg.symm))
    simpa only [Fintype.card_fin] using h
  subst m
  exact ⟨rfl, congrFun ((hf.range_inj hg).mp hRange)⟩

/-- A rooted neighborhood admits at most one plane slot set at a given
depth when siblings are listed in increasing label order. -/
theorem matchesPlaneShapes_slots_eq {V : Type*} [LinearOrder V] {S T : PlaneShape}
    (hD : S.depth = T.depth) {root : V} {neighbors : V → Set V} {f g : List ℕ → V}
    (hf : MatchesPlaneShape S root neighbors f) (hg : MatchesPlaneShape T root neighbors g) :
    S.slots = T.slots := by
  have h (n : ℕ) : ∀ v : List ℕ, v.length = n →
      (v ∈ S.slots ↔ v ∈ T.slots) ∧ (v ∈ S.slots → f v = g v) := by
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro v hlen
      induction v using List.reverseRecOn with
      | nil =>
        exact ⟨⟨fun _ ↦ T.root_mem, fun _ ↦ S.root_mem⟩, fun _ ↦ hf.1.trans hg.1.symm⟩
      | append_singleton u i _ =>
        have hShort : u.length < n := by simp [← hlen]
        obtain ⟨hU, hEq⟩ := ih _ hShort u rfl
        by_cases hS : u ∈ S.slots
        · have hT : u ∈ T.slots := hU.mp hS
          by_cases hd : u.length < S.depth
          · have hd' : u.length < T.depth := hD ▸ hd
            have hp : parentLabelSet f u = parentLabelSet g u := by
              unfold parentLabelSet
              split
              · rfl
              next hne =>
                have hu : u.dropLast ∈ S.slots := by
                  have hw : u.dropLast ++ [u.getLast hne] ∈ S.slots := by
                    rwa [List.dropLast_append_getLast hne]
                  exact ((S.child_mem _ _).mp hw).1
                have hshort : u.dropLast.length < n := by
                  have he := congrArg List.length (List.dropLast_append_getLast hne)
                  simp only [List.length_append, List.length_cons, List.length_nil, zero_add] at he
                  omega
                rw [(ih _ hshort _ rfl).2 hu]
            have hF := hf.2 u hS hd
            have hG := hg.2 u hT hd'
            have hr :
                range (fun j : Fin (S.childCount u) ↦ f (u ++ [j.val])) =
                  range (fun j : Fin (T.childCount u) ↦ g (u ++ [j.val])) := by
              rw [← hF.2, ← hG.2, hEq hS, hp]
            obtain ⟨hm, hEq'⟩ := eq_of_ordered_range hF.1 hG.1 hr
            refine ⟨?_, ?_⟩
            · rw [S.child_mem, T.child_mem]
              simp only [hS, hd, hT, hd', true_and, hm]
            · intro hs
              exact hEq' ⟨i, ((S.child_mem u i).mp hs).2.2⟩
          · have hd' : ¬ u.length < T.depth := hD ▸ hd
            simp only [S.child_mem, T.child_mem, hd, hd', and_false, false_and, iff_self]
            exact ⟨True.intro, False.elim⟩
        · have hT : u ∉ T.slots := fun h' ↦ hS (hU.mpr h')
          simp only [S.child_mem, T.child_mem, hS, hT, false_and, iff_self]
          exact ⟨True.intro, False.elim⟩
  ext v
  exact (h v.length v rfl).1

end Certificate.LocalExploration
